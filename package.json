{
    "name":  "factgrid",
    "version":  "0.0.0",
    "scripts":  {
                    "ng":  "ng",
                    "start":  "node server.js",
                    "build":  "ng build",
                    "test":  "ng test",
                    "lint":  "eslint \"src/**/*.{ts,html}\" --ext .ts,.html",
                    "lint:fix":  "eslint \"src/**/*.{ts,html}\" --ext .ts,.html --fix",
                    "format":  "prettier --write \"src/**/*.{ts,scss,css,html,json,md}\"",
                    "e2e":  "ng e2e",
                    "heroku-postbuild":  "ng build --configuration production",
                    "compodoc":  "npx compodoc -p tsconfig.doc.json",
                    "compodoc:serve":  "npx compodoc -p tsconfig.doc.json -s",
                    "theme":  "node switch-palette.js",
                    "theme:default":  "node switch-palette.js 0",
                    "theme:blue-orange":  "node switch-palette.js 1",
                    "theme:green-amber":  "node switch-palette.js 2",
                    "theme:violet-cyan":  "node switch-palette.js 3",
                    "theme:navy-coral":  "node switch-palette.js 4",
                    "theme:burgundy-gold":  "node switch-palette.js 5",
                    "theme:preview":  "start theme-preview.html",
                    "aif:check":  "node ./scripts/aif-check.js",
                    "install":  "^0.13.0",
                    "leaflet":  "^1.9.2",
                    "moment":  "^2.29.4",
                    "ngx-mat-select-search":  "^8.0.2",
                    "node":  "^23.7.0",
                    "node.js":  "^0.0.1-security",
                    "npm":  "^10.2.3",
                    "rxjs":  "^7.5.7",
                    "sass":  "^1.56.1",
                    "tslib":  "^2.4.1",
                    "zone.js":  "~0.15.1"
                },
    "devDependencies":  {
                            "@angular-devkit/build-angular":  "^20.0.1",
                            "@angular-eslint/builder":  "^21.0.1",
                            "@angular-eslint/eslint-plugin":  "^21.0.1",
                            "@angular-eslint/eslint-plugin-template":  "^21.0.1",
                            "@angular-eslint/schematics":  "^21.0.1",
                            "@angular-eslint/template-parser":  "^21.0.1",
                            "@angular/localize":  "^20.0.2",
                            "@compodoc/compodoc":  "^1.1.26",
                            "@types/geojson":  "^7946.0.10",
                            "@types/jasmine":  "~4.3.0",
                            "@types/leaflet":  "^1.9.0",
                            "@types/node":  "^18.11.9",
                            "@typescript-eslint/eslint-plugin":  "^8.47.0",
                            "@typescript-eslint/parser":  "^8.47.0",
                            "codelyzer":  "^6.0.2",
                            "eslint":  "^8.57.1",
                            "eslint-config-prettier":  "^10.1.8",
                            "eslint-plugin-prettier":  "^5.5.4",
                            "jasmine-core":  "~4.5.0",
                            "jasmine-spec-reporter":  "~7.0.0",
                            "karma":  "~6.4.1",
                            "karma-chrome-launcher":  "~3.1.1",
                            "karma-coverage":  "~2.2.0",
                            "karma-jasmine":  "~5.1.0",
                            "karma-jasmine-html-reporter":  "^2.0.0",
                            "prettier":  "^3.6.2",
                            "protractor":  "~7.0.0",
                            "schematics-scss-migrate":  "^1.3.15",
                            "ts-node":  "~10.9.1",
                            "tslint":  "~6.1.0",
                            "typescript":  "^5.8.3"
                        },
    "engines":  {
                    "node":  "\u003e=18.0.0",
