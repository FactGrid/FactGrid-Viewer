{
  "name": "factgrid",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node server.js",
    "build": "ng build",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:watch": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "test:once": "ng test --watch=false --browsers=ChromeHeadless",
    "lint": "eslint \"src/**/*.{ts,html}\" --ext .ts,.html",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" --ext .ts,.html --fix",
    "format": "prettier --write \"src/**/*.{ts,scss,css,html,json,md}\"",
    "e2e": "ng e2e",
    "e2e:puppeteer": "node scripts/check-overlay-attach.js",
    "heroku-postbuild": "ng build --configuration production",
    "compodoc": "npx compodoc -p tsconfig.doc.json",
    "compodoc:serve": "npx compodoc -p tsconfig.doc.json -s",
    "theme": "node switch-palette.js",
    "theme:default": "node switch-palette.js 0",
    "theme:blue-orange": "node switch-palette.js 1",
    "theme:green-amber": "node switch-palette.js 2",
    "theme:violet-cyan": "node switch-palette.js 3",
    "theme:navy-coral": "node switch-palette.js 4",
    "theme:burgundy-gold": "node switch-palette.js 5",
    "theme:preview": "start theme-preview.html",
    "aif:check": "node ./scripts/aif-check.js",
    "check:overlay-style": "node ./scripts/check-overlay-style.js",
    "validate:autocomplete-index": "node tools/validate-autocomplete-index.js"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.2",
    "@angular-eslint/builder": "^21.0.1",
    "@angular-eslint/eslint-plugin": "^21.0.1",
    "@angular-eslint/eslint-plugin-template": "^21.0.1",
    "@angular-eslint/schematics": "^21.0.1",
    "@angular-eslint/template-parser": "^21.0.1",
    "@angular/compiler-cli": "^21.0.3",
    "@angular/localize": "^21.0.3",
    "@compodoc/compodoc": "^1.1.26",
    "@types/file-saver": "^2.0.5",
    "@types/geojson": "^7946.0.10",
    "@types/jasmine": "~4.3.0",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^18.11.9",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "codelyzer": "^6.0.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jasmine-core": "~4.5.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.1",
    "karma-chrome-launcher": "~3.1.1",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.0.0",
    "prettier": "^3.6.2",
    "protractor": "~7.0.0",
    "schematics-scss-migrate": "^1.3.15",
    "ts-node": "~10.9.1",
    "tslint": "~6.1.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@angular/animations": "~21.0.3",
    "@angular/cdk": "^20.0.3",
    "@angular/cli": "~21.0.2",
    "@angular/common": "~21.0.3",
    "@angular/compiler": "~21.0.3",
    "@angular/core": "~21.0.3",
    "@angular/forms": "~21.0.3",
    "@angular/material": "^20.0.3",
    "@angular/material-moment-adapter": "^20.0.3",
    "@angular/platform-browser": "~21.0.3",
    "@angular/platform-browser-dynamic": "~21.0.3",
    "@angular/router": "~21.0.3",
    "file-saver": "^2.0.5",
    "file-saver-es": "^2.0.5",
    "leaflet": "^1.9.2",
    "ngx-mat-select-search": "^8.0.2",
    "puppeteer": "^24.32.1",
    "zone.js": "~0.15.1"
  }
}
