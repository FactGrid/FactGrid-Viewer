@@
`(backup of display.component.html before automated conversion)`

<!-- Spinner de chargement centré -->
@if (isSpinner) {
  <div class="spinner">
    <mat-spinner diameter=50 mode="indeterminate"></mat-spinner>
  </div>
}

<!-- Message d'erreur si P2 absent -->
@if (isError) {
  <div class="error-message">
    <p>Property P2 is missing.</p>
    <button (click)="addInFactGrid()">Add it in FactGrid</button>
  </div>
}

<!-- Conteneur principal avec drawer -->
@if (!isSpinner && !isError) {
  <mat-drawer-container class="drawer-container" [autosize]="true">
    <mat-drawer #drawer [mode]="isMobile ? 'over' : 'push'" [opened]="drawerOpened" (openedChange)="onDrawerToggled($event)" position="start" class="app-drawer">
          <mat-toolbar class="side-toolbar">
            <span class="example-spacer"></span>
            <span class="toolbar-text drawer-title">{{linkedPagesTitle}}</span>
            <button mat-icon-button class="close-btn drawer-icon-btn" (click)="toggleDrawer(false)" matTooltip="Fermer le panneau" aria-label="Fermer le panneau">
              <mat-icon class="drawer-icon">close</mat-icon>
            </button>
          </mat-toolbar>
          <div class="info-card-content">
        @for (link of linkedItems; track link.id) {
              <div class="selectedItemRow">
                <a class="selectedItemText" [routerLink]="['/item', link.id]" (click)="isMobile ? drawer.close() : null">{{link.label}}</a>
              </div>
            }
          </div>
        </mat-drawer>
  <mat-drawer-content>
          <!-- Bande supérieure: bouton pages liées + sélection projet + recherche item -->
            <mat-toolbar class="top-toolbar">
            <span class="drawer-title">
          @if (linkedItems?.length) { 
              ({{linkedItems.length}}) 
            }</span>
            <span class="example-spacer"></span>
            <app-search
              [compact]="true"
              (itemSelected)="onSearchItemSelected($event)">
            </app-search>
          </mat-toolbar>

          <div class="parent">
            <div class="child1">
              <!-- Vue d'accueil lorsqu'aucun item n'est chargé false remplace provisoirement item-->
            @if (item) {
              <div class="thematic-cards-grid">
                    <!-- Titre / info principal (remplacé hors de la carte thématique) -->
                <div class="info-header info-themed-content">
                  <div class="itemTitle">{{ label }}</div>
                @if (aliases?.length) { 
                  <div class="aliases">{{ aliases | join:', ' }}</div> 
                }
                @if (description) { 
                    <div class="itemDescription">{{ description }}</div> 
                }
                  <!-- FactGrid ID always visible, aligned with title -->
                @if (id && factGridUrl) {
                    <div class="factgrid-global">
                      <span class="factgrid-label">FactGrid:</span>
                      <a [href]="factGridUrl + id" target="_blank" rel="noopener" class="factgrid-link-global hover-bg-light">{{id}}</a>
                    </div>
                  }
                </div>
                @if (isMobile) {
                  <div class="img2" [ngClass]="pictures.length > 0 ? 'show-division':'hide-division'">
                    @for (picture of pictures; track picture.uniqueKey) {
                      <div>
                        <img mat-card-image [src]="picture.thumbnail"
                             [attr.data-src]="picture.full"
                             loading="lazy"
                             alt="Image description"
                             (load)="onThumbnailLoad(picture)"
                             (click)="openImage(picture.full)" />
                      </div>
                    }
                  </div>
                }
               @if (isIdentity) {
                  <app-thematic-card [collapsible]="true" [title]="identityTitle">
                    <app-generic-list-display [title]="identityTitle" [items]="identity"></app-generic-list-display>
                  </app-thematic-card>
                }
              @if (isPerson) {
                  <app-thematic-card [collapsible]="true" [title]="'Biographie'">
                    <app-generic-list-display [title]="'Biographie'" [items]="lifeAndFamily"></app-generic-list-display>
                  </app-thematic-card>
                }
              @if (trans !== "") { <app-thematic-card><app-text-display [trans]="trans"></app-text-display></app-thematic-card> 
               } <!----transcription-->
              @if (isTraining) {
                  <app-thematic-card [collapsible]="true" [startCollapsed]="true" [title]="training">
                    <app-generic-list-display  [title]="training" [items]="education"></app-generic-list-display>
                  </app-thematic-card>
                }
              @if (isCareer) {
                  <app-thematic-card [collapsible]="true" [startCollapsed]="true" [title]="careerTitle">
                    <app-generic-list-display [title]="careerTitle" [items]="careerAndActivities"></app-generic-list-display>
                  </app-thematic-card>
                }
              @if (isSociability) {
                 
                  <app-thematic-card [collapsible]="true" [startCollapsed]="true" [title]="sociabilityTitle">
                    <app-generic-list-display [title]="sociabilityTitle" [items]="sociabilityAndCulture"></app-generic-list-display>
                  </app-thematic-card>
                }
              @if (isCulture) {
                  <app-thematic-card [collapsible]="true" [startCollapsed]="true" [title]="cultureTitle">
                    <app-generic-list-display [title]="cultureTitle" [items]="culture"></app-generic-list-display>
                  </app-thematic-card>
                }
             @if (isCareerStatement) {
                  <app-thematic-card [collapsible]="true" [startCollapsed]="true" [title]="careerStatementTitle">
                    <app-generic-list-display [title]="careerStatementTitle" [items]="careerStatementDetail"></app-generic-list-display>
                  </app-thematic-card>
                }
              @if (isMain) {
                    <app-thematic-card collapsible="true" [title]="mainTitle" icon="star" [startCollapsed]="lifeAndFamily?.length">
                        <div class="thematic-card-header-bar"></div>
                      <app-generic-list-display [title]="''" [items]="mainList"></app-generic-list-display>
                      </app-thematic-card>
                }
              @if (isIframes) { <app-thematic-card><app-iframes-display [iframeGroups]="iframeGroups"></app-iframes-display></app-thematic-card> 
                }
                <!-- SPARQL cards: avoid wrapper ng-container to prevent DOM wrappers from affecting spacing -->
              @if ((sparqlCards$ | async)?.sparql0.list?.length) {
                  <app-thematic-card [collapsible]="true" [startCollapsed]="true" [title]="(sparqlCards$ | async)?.sparql0.title">
                       <app-sparql-display
                          #sparqlDisplay0
                          sparqlType="sparql0"
                          [sparqlData]="(sparqlCards$ | async)?.sparql0.list"
                          [sparqlSubject]="(sparqlCards$ | async)?.sparql0.subject"
                          [langService]="lang"
                          [parentTitle]="(sparqlCards$ | async)?.sparql0.title">
                        </app-sparql-display>
                  </app-thematic-card>
                }

              @if ((sparqlCards$ | async)?.sparql1.list?.length) {
                        <app-thematic-card [collapsible]="true" [startCollapsed]="true" [title]="(sparqlCards$ | async)?.sparql1.title">
          
                         <app-sparql-display
                          #sparqlDisplay1
                          sparqlType="sparql1"
                          [sparqlData]="(sparqlCards$ | async)?.sparql1.list"
                          [sparqlSubject]="(sparqlCards$ | async)?.sparql1.subject"
                          [langService]="lang"
                          [parentTitle]="(sparqlCards$ | async)?.sparql1.title">
                        </app-sparql-display>
                        </app-thematic-card>
             }

              @if ((sparqlCards$ | async)?.sparql2.list?.length) {
                        <app-thematic-card [collapsible]="true" [startCollapsed]="true" [title]="(sparqlCards$ | async)?.sparql2.title">          
                       <app-sparql-display
                          #sparqlDisplay2
                          sparqlType="sparql2"
                          [sparqlData]="(sparqlCards$ | async)?.sparql2.list"
                          [sparqlSubject]="(sparqlCards$ | async)?.sparql2.subject"
                          [langService]="lang"
                          [parentTitle]="(sparqlCards$ | async)?.sparql2.title">
                          </app-sparql-display>
                        </app-thematic-card>
                }

              @if ((sparqlCards$ | async)?.sparql3.list?.length) {
                        <app-thematic-card [collapsible]="true" [startCollapsed]="true" [title]="(sparqlCards$ | async)?.sparql3.title">  
                          <app-sparql-display
                          #sparqlDisplay3
                          sparqlType="sparql3"
                          [sparqlData]="(sparqlCards$ | async)?.sparql3.list"
                          [sparqlSubject]="(sparqlCards$ | async)?.sparql3.subject"
                          [langService]="lang"
                          [parentTitle]="(sparqlCards$ | async)?.sparql3.title">
                          </app-sparql-display>
                        </app-thematic-card>
               }
              @if ((sparqlCards$ | async)?.sparql4.list?.length) {
                        <app-thematic-card [collapsible]="true" [startCollapsed]="true" [title]="(sparqlCards$ | async)?.sparql4.title">   
                         <app-sparql-display
                          #sparqlDisplay4
                          sparqlType="sparql4"
                          [sparqlData]="(sparqlCards$ | async)?.sparql4.list"
                          [sparqlSubject]="(sparqlCards$ | async)?.sparql4.subject"
                          [langService]="lang"
                          [parentTitle]="(sparqlCards$ | async)?.sparql4.title">
                        </app-sparql-display>
                        </app-thematic-card>
                      }
             @if (showSources) {
              <app-thematic-card [collapsible]="true"  [startCollapsed]="true" [title]="sources">
                    <app-generic-list-display [title]="sources" [items]="sourcesList"></app-generic-list-display>
                  </app-thematic-card>
               }
               <app-thematic-card [collapsible]="true"  [startCollapsed]="true" title="Informations sur l'élément">
                  <app-item-info [infoList]="infoList"></app-item-info>
              </app-thematic-card>
            </div>
         } 
         @else {
                <div class="thematic-cards-grid">
                  <div class="matCardPadding">
                    <div class="itemTitle">FactGrid</div>
                    <div class="itemDescription" style="margin-bottom: 8px;">
                      {{ subtitle }}
                    </div>

                    <!-- Projet sélectionné -->
                    @if (currentProject && currentProject.id !== 'all') {
                      <div class="itemDescription" style="margin-bottom: 12px;">
                        <strong>{{ currentProject.name }}</strong>
                        @if (currentProject.description) { <span> – {{ currentProject.description }}</span> 
                      }
                      </div>
                    }

                    <p class="itemDescription">
                      Utilisez la barre de recherche en haut pour trouver une personne, une publication ou un autre item dans FactGrid.<br>
                      Vous pouvez également sélectionner un projet, puis commencer à taper quelques lettres du nom ou du titre pour afficher les résultats ici.
                    </p>
                  </div>
                </div>
              }



              <!--  ************************************* sparql3 ****************************************
  <div class="matCardPadding" [ngClass]="isSparql0 ? 'show-division':'hide-division'">
    <mat-card appearance="outlined" class=mat-elevation-z12>
      <app-sparql3-display [item]="this.item"></app-sparql3-display>
    </mat-card>
  </div>-->
              <!-- ******************************* Info ****************************************  -->
              <div class="matCardPadding" style="display: none;">
                <mat-card appearance="outlined" class="mat-elevation-z12 info-card">
                  <div class="info-card-header">
                    <button mat-icon-button (click)="toggleInfo()" class="icon whiteText">
                      <mat-icon class="icon whiteButton">
                        {{ isInfo ? 'expand_less' : 'expand_more' }}
                      </mat-icon>
                    </button>
                  </div>
                  <div class="info-card-closed-spacer" [ngClass]="isInfo ? 'hide-division' : 'show-division'"></div>
                  <mat-card-content class="info-card-content" [ngClass]="isInfo ? 'show-division' : 'hide-division'">
                    <app-item-info [infoList]="infoList"></app-item-info>
                  </mat-card-content>
                </mat-card>
              </div>

            </div>
            <!-- ****************************************** Pictures ****************************************  -->
            <div class="child2">
                @if (!isMobile) {
                  <mat-card appearance="outlined">
                    <div class="img2" [ngClass]="isPicture ? 'show-division':'hide-division'">
                      @for (picture of pictures; track picture.uniqueKey) {
                        <div>
                          <img mat-card-image [src]="picture.thumbnail"
                               [attr.data-src]="picture.full"
                               loading="lazy"
                               alt="Image description"
                               (load)="onThumbnailLoad(picture)"
                               (click)="openImage(picture.full)" />
                        </div>
                      }
                    </div>
                  </mat-card>
                }  
                <!-- ************************************* external links ****************************************  -->
                      <!--          <div>   -->
                      <mat-card appearance="outlined" class="external-links">
                        <mat-card-content [ngClass]="isExternalLinks ? 'show-division':'hide-division'">
                          <div class="externalLinksPadding">
                            <div class="divisionTitle">{{externalLinksTitle}}</div>
                            <hr>
                          </div>
                          @for (externalLink of externalLinks; track externalLink.label) {
                          <div class="externalLinksText">
                            <span>{{externalLink.label}}: </span><a href="{{externalLink.url}}" target="_blank">
                              {{externalLink[0].mainsnak.datavalue.value}}
                            </a><span>&nbsp;&nbsp;</span>
                          </div>
                          }
                        </mat-card-content>


                        <!-- ************************************* wikis links ****************************************  -->

                        <mat-card-content class="header-spacer" [ngClass]="isWikis ? 'show-division':'hide-division'">
                          <div class="externalLinksPadding">
                            <div class="divisionTitle">Wikis</div>
                            <hr>
                          </div>
                          @for (wiki of wikis; track wiki.uniqueKey) {
                          <div class="wikiEntry">
                            <div class="wikiSite"><span class="propertyStyle">{{wiki.site}}:&nbsp;</span></div>
                            <div class="wikiTitle"><a class="externalLinksText linkedItemText displayLayout" href="{{wiki.url}}" target="_blank">{{wiki.title}}</a></div>
                          </div>
                          }
                        </mat-card-content>
                      </mat-card>
                      <!--              </div> -->
                      <!-- ************************************* selected items  ****************************************  -->
                      <!--         <div>  -->
                      <mat-card appearance="outlined" class="mat-elevation-z8 itemSelected-mat-card">
                        <div class="info-card-header selectedListTitle">
                          <mat-icon class="icon blue-text">history</mat-icon>
                          {{formerVisitsTitle}}
                        </div>
                        <mat-card-content class="info-card-content">
                          @if (selectedItemsList?.length === 0) { <div class="itemDescription">Aucune visite précédente.</div> 
                        }
                          <div *ngFor="let selectedItem of selectedItemsList" class="selectedItemRow">
                            @if (selectedItem) { <span>
                              <a class="selectedItemLink"
                                 [routerLink]="['/item', selectedItem?.value?.id]"
                                 (click)="$event.stopPropagation()"
                                 >
                                {{selectedItem.label}}
                              </a>
                            </span> 
                          }
                          </div>
                        </mat-card-content>
                      </mat-card>
            </div>
          </div>
      </mat-drawer-content>
  </mat-drawer-container>
}